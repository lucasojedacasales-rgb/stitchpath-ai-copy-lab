{
  "name": "RuleCandidate",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "geometric_conditions": {
      "type": "object"
    },
    "fabric_profile": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictory_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "physical_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "validating",
        "approved",
        "rejected"
      ],
      "default": "candidate"
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "rule_id",
    "title"
  ]
}