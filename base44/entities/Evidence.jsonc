      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emb_file_name": {
      "type": "string"
    },
    "dst_file_name": {
      "type": "string"
    },
    "observations": {
      "type": "string"
    },
    "physical_photos": {
      "type": "array",
